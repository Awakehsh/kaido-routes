        "payment_method": "ETC"
      },
      "pre_drive_evidence_bundle": {
        "schema_version": "1.0",
        "release_id": "test.pre-drive-evidence-bundle.v1",
        "released_at": "2026-07-25T12:15:00+09:00",
        "evidence_scope": "SYNTHETIC_TEST_ONLY",
        "product_release_id": "test.product.pre-drive-bundle",
        "navigation_release_id": "test.navigation.pre-drive-bundle",
        "network_snapshot_id": "test.snapshot.pre-drive-bundle",
        "route_plan_id": "test.plan.pre-drive-bundle",
        "source_registry": [
          {
            "source_reference_id": "test.source.pre-drive-tariff",
            "roles": ["TARIFF_QUERY"],
