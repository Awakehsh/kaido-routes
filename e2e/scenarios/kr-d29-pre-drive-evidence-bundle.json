{
  "schema_version": "1.0",
  "id": "KR-D29",
  "title": "Hash-bound pre-drive evidence resolves only a fresh exact tariff profile",
  "layer": "DOMAIN",
  "tags": ["pre-drive", "evidence", "freshness", "release", "fail-closed"],
  "purpose": "Keep dated tariff and passage evidence separate from the versioned product release while requiring exact product, RoutePlan, vehicle-class, payment-method, provenance, and validity-window agreement before pre-drive admission.",
  "evidence": {
    "classification": "SYNTHETIC",
    "sources": [],
    "limitations": [
      "The released identifiers and official-looking values are synthetic contract fixtures.",
      "This scenario does not provide a current toll quote, realtime passage authority, or real-road navigation authority."
    ],
    "release_blockers": []
  },
  "given": {
    "network_snapshot": {
      "id": "test.snapshot.pre-drive-bundle",
      "status": "TEST",
      "effective_at": "2026-07-25T00:00:00+09:00"
    },
    "route_plan": {
      "plan_id": "test.plan.pre-drive-bundle",
      "network_snapshot_id": "test.snapshot.pre-drive-bundle",
      "entry_facility_id": "test.entrance.pre-drive-bundle",
      "exit_facility_id": "test.exit.pre-drive-bundle",
      "recovery_policy": "STRICT",
      "actual_distance_km": 27.4,
      "occurrences": [
        {
          "occurrence_id": "test.occurrence.pre-drive-bundle",
          "index": 0,
          "kind": "EDGE",
          "entity_id": "test.edge.pre-drive-bundle"
        }
      ]
    },
    "inputs": {
      "pre_drive_session": {
        "network_snapshot_id": "test.snapshot.pre-drive-bundle",
        "route_plan_id": "test.plan.pre-drive-bundle",
