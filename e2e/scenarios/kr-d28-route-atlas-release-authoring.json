    {
      "id": "reject-route-atlas-draft-schema",
      "at_ms": 1,
      "type": "ROUTE_ATLAS_RELEASE_AUTHORED",
      "payload": {"draft_schema_version": "2.0"}
    },
    {
      "id": "reject-route-atlas-configuration-schema",
      "at_ms": 2,
      "type": "ROUTE_ATLAS_RELEASE_AUTHORED",
      "payload": {"configuration_schema_version": "2.0"}
    }
  ],
  "then": [
    {
      "id": "route-atlas-authoring-passes",
      "after": "author-route-atlas-release",
      "category": "SAFETY",
      "subject": "route_atlas.authoring_status",
      "matcher": "EQUALS",
      "expected": "PASS",
      "rationale": "Only the complete artifact derived from separate reviewed content and evidence may pass."
    },
    {
      "id": "route-atlas-draft-schema-is-explicit",
      "after": "author-route-atlas-release",
      "category": "EVIDENCE",
      "subject": "route_atlas.draft_schema_version",
      "matcher": "EQUALS",
      "expected": "1.0",
      "rationale": "An unknown draft shape cannot be treated as current reviewed topology or layout."
    },
    {
      "id": "route-atlas-configuration-schema-is-explicit",
      "after": "author-route-atlas-release",
      "category": "EVIDENCE",
      "subject": "route_atlas.authoring_configuration_schema_version",
      "matcher": "EQUALS",
      "expected": "1.0",
      "rationale": "Source provenance and release evidence have their own explicit schema."
    },
    {
      "id": "route-atlas-artifact-schema-is-derived",
      "after": "author-route-atlas-release",
      "category": "DOMAIN",
      "subject": "route_atlas.schema_version",
      "matcher": "EQUALS",
      "expected": "1.0",
      "rationale": "The author derives the supported artifact schema instead of copying a caller-selected value."
    },
    {
      "id": "route-atlas-route-plan-is-preserved",
      "after": "author-route-atlas-release",
      "category": "SAFETY",
      "subject": "route_atlas.route_plan_id",
      "matcher": "EQUALS",
      "expected": "test.plan.route-atlas-authoring",
      "rationale": "Atlas assembly cannot optimize, migrate, or replace the reviewed RoutePlan."
    },
    {
      "id": "unknown-route-atlas-draft-schema-blocks",
      "after": "reject-route-atlas-draft-schema",
      "category": "SAFETY",
      "subject": "route_atlas.error_codes",
      "matcher": "CONTAINS",
      "expected": "INVALID_ROUTE_ATLAS_RELEASE_DRAFT_SCHEMA_VERSION",
      "rationale": "Unknown reviewed-content schemas fail before any artifact is returned."
    },
    {
      "id": "unknown-route-atlas-configuration-schema-blocks",
      "after": "reject-route-atlas-configuration-schema",
      "category": "SAFETY",
      "subject": "route_atlas.error_codes",
      "matcher": "CONTAINS",
      "expected": "INVALID_ROUTE_ATLAS_RELEASE_AUTHORING_SCHEMA_VERSION",
      "rationale": "Unknown provenance schemas fail before any artifact is returned."
    }
  ]
