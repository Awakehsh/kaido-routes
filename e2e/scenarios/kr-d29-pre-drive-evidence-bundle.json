  "when": [
    {
      "id": "resolve-fresh-profile",
      "at_ms": 0,
      "type": "PRE_DRIVE_EVIDENCE_BUNDLE_RESOLVED",
      "payload": {
        "product_release_id": "test.product.pre-drive-bundle",
        "product_released_at": "2026-07-25T12:00:00+09:00",
        "navigation_release_id": "test.navigation.pre-drive-bundle",
        "evidence_scope": "SYNTHETIC_TEST_ONLY",
        "resolved_at": "2026-07-25T12:30:00+09:00"
      }
    },
    {
      "id": "reject-expired-profile",
      "at_ms": 1,
      "type": "PRE_DRIVE_EVIDENCE_BUNDLE_RESOLVED",
      "payload": {
        "product_release_id": "test.product.pre-drive-bundle",
        "product_released_at": "2026-07-25T12:00:00+09:00",
        "navigation_release_id": "test.navigation.pre-drive-bundle",
        "evidence_scope": "SYNTHETIC_TEST_ONLY",
        "resolved_at": "2026-07-26T00:00:00+09:00"
      }
    },
    {
      "id": "reject-missing-payment-profile",
      "at_ms": 2,
      "type": "PRE_DRIVE_EVIDENCE_BUNDLE_RESOLVED",
      "payload": {
        "product_release_id": "test.product.pre-drive-bundle",
        "product_released_at": "2026-07-25T12:00:00+09:00",
        "navigation_release_id": "test.navigation.pre-drive-bundle",
        "evidence_scope": "SYNTHETIC_TEST_ONLY",
        "resolved_at": "2026-07-25T12:30:00+09:00",
        "payment_method": "CASH"
      }
    }
  ],
  "then": [
    {
      "id": "fresh-exact-profile-passes",
      "after": "resolve-fresh-profile",
      "category": "SAFETY",
      "subject": "pre_drive.bundle.status",
      "matcher": "EQUALS",
      "expected": "VALID",
      "rationale": "Only a record inside its validity window and matching the selected session may reach pre-drive evaluation."
    },
    {
      "id": "bundle-identity-is-retained",
      "after": "resolve-fresh-profile",
      "category": "EVIDENCE",
      "subject": "pre_drive.bundle.release_id",
      "matcher": "EQUALS",
      "expected": "test.pre-drive-evidence-bundle.v1",
      "rationale": "Runtime evidence remains traceable to one hash-pinned bundle identity."
    },
    {
      "id": "both-source-roles-are-retained",
      "after": "resolve-fresh-profile",
      "category": "EVIDENCE",
      "subject": "pre_drive.bundle.source_count",
      "matcher": "EQUALS",
      "expected": 2,
      "rationale": "The record requires separately identified tariff and passage provenance."
    },
    {
      "id": "exact-tariff-is-selected",
      "after": "resolve-fresh-profile",
      "category": "TOLL",
      "subject": "pre_drive.bundle.selected_quote_id",
      "matcher": "EQUALS",
      "expected": "test.quote.pre-drive-standard-etc",
      "rationale": "The unique active quote is selected only after complete bundle and session validation."
    },
    {
      "id": "expiry-blocks",
      "after": "reject-expired-profile",
      "category": "SAFETY",
      "subject": "pre_drive.bundle.status",
      "matcher": "EQUALS",
      "expected": "BLOCKED",
      "rationale": "An evidence record is unavailable at its exclusive expiry boundary."
    },
    {
      "id": "expiry-has-stable-code",
      "after": "reject-expired-profile",
      "category": "EVIDENCE",
      "subject": "pre_drive.bundle.error_codes",
      "matcher": "CONTAINS",
      "expected": "PRE_DRIVE_EVIDENCE_EXPIRED",
      "rationale": "The App can distinguish stale evidence from an absent release."
    },
    {
      "id": "missing-profile-blocks",
      "after": "reject-missing-payment-profile",
      "category": "SAFETY",
      "subject": "pre_drive.bundle.status",
      "matcher": "EQUALS",
      "expected": "BLOCKED",
      "rationale": "A CASH selection cannot reuse the reviewed ETC record."
    },
    {
      "id": "missing-profile-has-stable-code",
      "after": "reject-missing-payment-profile",
      "category": "EVIDENCE",
      "subject": "pre_drive.bundle.error_codes",
      "matcher": "CONTAINS",
      "expected": "PRE_DRIVE_EVIDENCE_PROFILE_UNAVAILABLE",
      "rationale": "Profile absence remains explicit and never falls back to another vehicle or payment path."
    }
  ]
}
