            "checked_at": "2026-07-25T11:30:00+09:00",
            "reviewer_id": "test.reviewer.tariff",
            "reviewed_at": "2026-07-25T12:10:00+09:00"
          },
          {
            "source_reference_id": "test.source.pre-drive-passage",
            "roles": ["PASSAGE_REVIEW"],
            "authority_name": "Synthetic passage authority",
            "source_url": "https://example.test/pre-drive-passage",
            "content_sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "checked_at": "2026-07-25T11:35:00+09:00",
            "reviewer_id": "test.reviewer.passage",
            "reviewed_at": "2026-07-25T12:10:00+09:00"
          }
        ],
        "records": [
          {
            "record_id": "test.record.pre-drive-standard-etc",
            "valid_from": "2026-07-25T12:00:00+09:00",
