      "id": "overlay-passes",
      "after": "project-released-atlas",
      "category": "SAFETY",
      "subject": "route_atlas.overlay.status",
      "matcher": "EQUALS",
      "expected": "PASS",
      "rationale": "Only one validated released atlas may produce the route overlay."
    },
    {
      "id": "overlay-binds-route-plan",
      "after": "project-released-atlas",
      "category": "DOMAIN",
      "subject": "route_atlas.overlay.route_plan_id",
      "matcher": "EQUALS",
      "expected": "test.plan.route-atlas-overlay",
      "rationale": "The overlay cannot consume progress from another RoutePlan."
    },
    {
      "id": "context-remains-separate",
      "after": "project-released-atlas",
      "category": "UI",
      "subject": "route_atlas.overlay.context_segment_ids",
      "matcher": "CONTAINS",
      "expected": "test.segment.context",
      "rationale": "Released context remains visible without becoming an active occurrence."
    },
    {
      "id": "ordered-occurrences-remain-distinct",
      "after": "project-released-atlas",
      "category": "UI",
      "subject": "route_atlas.overlay.occurrence_ids",
      "matcher": "EQUALS",
      "expected": [
        "test.occurrence.loop-1",
        "test.occurrence.turn",
        "test.occurrence.loop-2",
        "test.occurrence.exit"
      ],
      "rationale": "The renderer receives occurrence order rather than a deduplicated segment set."
    },
    {
      "id": "actor-progress-owns-state",
      "after": "project-released-atlas",
      "category": "NAVIGATION",
      "subject": "route_atlas.overlay.occurrence_states",
      "matcher": "EQUALS",
      "expected": [
        "test.occurrence.loop-1=PASSED",
        "test.occurrence.turn=PASSED",
        "test.occurrence.loop-2=CURRENT",
        "test.occurrence.exit=FUTURE"
      ],
      "rationale": "Passed, current, and future state comes from the actor snapshot, not SwiftUI inference."
    },
    {
      "id": "current-occurrence-is-exact",
      "after": "project-released-atlas",
      "category": "NAVIGATION",
      "subject": "route_atlas.overlay.current_occurrence_id",
      "matcher": "EQUALS",
      "expected": "test.occurrence.loop-2",
      "rationale": "The second traversal is current even though it shares a segment with an earlier traversal."
    },
    {
      "id": "repeated-segment-remains-repeated",
      "after": "project-released-atlas",
      "category": "DOMAIN",
      "subject": "route_atlas.overlay.segment_bindings",
      "matcher": "EQUALS",
      "expected": [
        "test.occurrence.loop-1=test.segment.loop",
        "test.occurrence.turn=test.segment.turn",
        "test.occurrence.loop-2=test.segment.loop",
        "test.occurrence.exit=test.segment.exit"
      ],
      "rationale": "Two occurrence values may bind the same released segment without being merged."
    },
    {
      "id": "repeat-ordinals-are-exposed",
      "after": "project-released-atlas",
      "category": "UI",
      "subject": "route_atlas.overlay.repeat_ordinals",
      "matcher": "CONTAINS",
      "expected": "test.occurrence.loop-2=2/2",
      "rationale": "The renderer can distinguish the second traversal without inventing another topology edge."
    }
