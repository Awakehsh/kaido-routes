{
  "schema_version": "1.0",
  "id": "KR-D28",
  "title": "Route Atlas release authoring keeps reviewed content separate from evidence",
  "layer": "DOMAIN",
  "tags": ["route-atlas", "authoring", "provenance", "fail-closed"],
  "purpose": "Require the final Route Atlas artifact to be derived from an evidence-free reviewed draft plus separate topology and layout release evidence before the whole integrity gate runs.",
  "evidence": {
    "classification": "SYNTHETIC",
    "sources": [],
    "limitations": [
      "RELEASED inside this synthetic fixture exercises authoring mechanics only.",
      "This scenario does not establish real Shuto topology, layout, provenance, or release eligibility."
    ],
    "release_blockers": []
  },
  "given": {
